+        "onnxvoice>=0.2.0,<0.3.0",
+        "onnxvoice[cpu]>=0.2.0,<0.3.0",
+        "onnxvoice[gpu]>=0.2.0,<0.3.0",
+        "onnxvoice>=0.2.0,<0.3.0",
+    ]

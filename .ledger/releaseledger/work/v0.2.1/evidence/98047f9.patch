+def test_onnxvoice_dependency_ranges_require_02_line() -> None:
+    project = Path(__file__).parents[1] / "pyproject.toml"
+    requirements = re.findall(
+        r'"(onnxvoice(?:\[(?:cpu|gpu)\])?>[^"]+)"',
+        project.read_text(encoding="utf-8"),

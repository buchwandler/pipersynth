+    language="en-us",
+    chunking=TextChunkingConfig(mode="none"),
+ )
+assert result.audio.size == 1
+assert [chunk.index for chunk in result.chunks] == [0]
+voice.close()
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", command],
+        check=False,
+        capture_output=True,
+        text=True,
+    )

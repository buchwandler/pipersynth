-```python
-from pipersynth import PiperPipeline, PipelineConfig
+segment = SynthesisSegment(
+    id="line-001",
+    text="I read the book yesterday.",
+    language="en-us",
+    pronunciation_overrides=(PronunciationOverride(2, 6, phonemes="ɹɛd"),),
+    annotations=(
+        LinguisticToken(

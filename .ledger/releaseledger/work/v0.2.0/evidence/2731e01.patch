-                repeats=repeats,
-                error=f"worker exited with status {completed.returncode}",
-                error_type="WorkerProcessError",
-            )
-        if not output_path.is_file():
-            return [], worker_failures(
-                entries,
-                repeats=repeats,
-                error="worker did not produce a result file",
